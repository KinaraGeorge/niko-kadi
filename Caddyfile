# SITE_ADDRESS comes from compose.yaml. A bare hostname (e.g. 2-25-6-88.sslip.io)
# gets a free Let's Encrypt certificate; "http://localhost" serves plain HTTP for local tests.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Real-time game traffic (WebSockets) goes to the game server.
	handle /socket.io/* {
		reverse_proxy game:4000
	}

	# Everything else is the Next.js site.
	handle {
		reverse_proxy web:3000
	}
}
